# Copy this file to .env.local for local development
# On Vercel: set these in Project Settings > Environment Variables

# Backend API URL (required)
VITE_API_BASE_URL=https://droneoptai.id.vn/api/v1

# Optional: set to "true" to send cookies with requests
VITE_API_WITH_CREDENTIALS=false

# MapTiler key for live tracking / hub maps (required for maps to render)
# Get one at https://cloud.maptiler.com/account/keys/ — never commit the real key
VITE_MAPTILER_API_KEY=your_maptiler_key_here
